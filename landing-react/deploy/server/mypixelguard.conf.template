# STEP 2 (full). Replaces the http-only file once the certificate exists. Added alongside default.conf.template.
# Does not modify any existing server block.
#
# The upstream names are put in variables on purpose: nginx then looks them up when a request arrives, not when it starts.
# So if the mypixelguard containers are ever stopped, the ERP's nginx still starts and reloads normally.

server {
    listen 80;
    server_name mypixelguard.agentiqbd.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name mypixelguard.agentiqbd.com;

    ssl_certificate     /etc/letsencrypt/live/mypixelguard.agentiqbd.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mypixelguard.agentiqbd.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Docker's internal DNS
    resolver 127.0.0.11 valid=10s;

    # nothing is ever uploaded through this site (only the counter's tiny POST)
    client_max_body_size 4k;

    # visitor counter
    location /api/ {
        set $mpg_counter http://mypixelguard-counter:8787;
        proxy_pass $mpg_counter;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # big installer files: stream straight through instead of buffering them to disk in the ERP's nginx container
    location /downloads/ {
        set $mpg_web http://mypixelguard-web:8080;
        proxy_pass $mpg_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
    }

    # the landing page
    location / {
        set $mpg_web http://mypixelguard-web:8080;
        proxy_pass $mpg_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
