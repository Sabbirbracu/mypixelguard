# /etc/systemd/system/mypixelguard-counter.service
[Unit]
Description=MyPixelGuard visitor counter
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/mypixelguard/counter
ExecStart=/usr/bin/node visitor-counter.mjs
Environment=PORT=8787
Environment=DATA_FILE=/var/www/mypixelguard/counter-data/visitors.json
Environment=ALLOW_ORIGIN=https://mypixelguard.agentiqbd.com
Environment=TRUST_PROXY=1
Restart=always
RestartSec=3
# the counter only needs to read/write its own data file
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/mypixelguard/counter-data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
