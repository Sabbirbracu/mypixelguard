{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPixelGuard",
  "version": "1.0.0",
  "identifier": "com.agentiqbd.mypixelguard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyPixelGuard",
        "width": 1180,
        "height": 800,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Your Images. Your Privacy. Your Control.",
    "copyright": "Copyright \u00a9 2026 Agentiq BD. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../models/isnet-general-use.onnx": "models/isnet-general-use.onnx",
      "../models/face_detection_yunet_2023mar.onnx": "models/face_detection_yunet_2023mar.onnx"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": [
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  }
}
